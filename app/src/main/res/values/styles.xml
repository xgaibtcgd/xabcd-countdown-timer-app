<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:navigationBarColor">@color/system_bar</item>
        <item name="android:statusBarColor">@color/system_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- The few remaining dialogs (the PIN prompt and the task editor) inherit the
             brand, rather than looking like stock Android beside the drawn UI. -->
        <item name="android:alertDialogTheme">@style/AppDialog</item>
    </style>

    <style name="AppDialog" parent="android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif-rounded</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
</resources>
